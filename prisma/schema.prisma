generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  INDIVIDUAL
  DEALER
  CORPORATE
  ADMIN
}

enum ListingType {
  FIXED_PRICE
  AUCTION
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SOLD
  EXPIRED
  REJECTED
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ConsignmentStatus {
  PENDING
  UNDER_REVIEW
  MATCHING_DEALER
  DEALER_ASSIGNED
  VEHICLE_IN_SALE
  NEGOTIATION
  COMPLETED
  CANCELLED
}

enum VehiclePhotoCategory {
  FRONT
  REAR
  RIGHT
  LEFT
  INTERIOR
  ODOMETER
  ENGINE
  TRUNK
  DAMAGE
}

enum DealerAssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id                  String                @id @default(cuid())
  accountType         AccountType           @default(INDIVIDUAL)
  fullName            String
  email               String                @unique
  passwordHash        String
  phone               String?
  city                String?
  district            String?
  address             String?               @db.Text
  companyName         String?
  taxOffice           String?
  taxNumber           String?
  listingVolume       String?
  packagePlan         String?
  authorizedFirstName String?
  authorizedLastName  String?
  documentConfirmed   Boolean               @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  listings            Listing[]
  bids                Bid[]
  sessions            AuthSession[]
  favorites           Favorite[]
  sentMessages        Message[]             @relation("MessageSender")
  buyerConversations  Conversation[]        @relation("ConversationBuyer")
  sellerConversations Conversation[]        @relation("ConversationSeller")
  consignmentRequests ConsignmentRequest[]
  dealerAssignments   DealerAssignment[]    @relation("AssignedDealer")
}

model Listing {
  id          String         @id @default(cuid())
  sellerId    String
  title       String
  description String
  category    String
  brand       String
  model       String
  packageName String?
  year        Int
  km          Int
  city        String
  district    String?
  fuelType    String
  transmission String
  bodyType    String
  color       String
  engineVolume String?
  enginePower  String?
  driveType    String?
  condition    String      @default("Ikinci El")
  plateOrigin  String?
  fromWho      String      @default("Sahibinden")
  exchangeAllowed Boolean  @default(false)
  damageRecord  String?
  price       Decimal?       @db.Decimal(12, 2)
  currency    String         @default("TRY")
  listingType ListingType
  status      ListingStatus  @default(PENDING_REVIEW)
  moderationNote String      @default("")
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  seller      User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  images      ListingImage[]
  auction     Auction?
  favorites   Favorite[]
  conversations Conversation[]

  @@index([city, status, listingType])
  @@index([sellerId, createdAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  imageUrl  String
  sortOrder Int      @default(0)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Auction {
  id           String        @id @default(cuid())
  listingId    String        @unique
  startPrice   Decimal       @db.Decimal(12, 2)
  minIncrement Decimal       @db.Decimal(12, 2)
  reservePrice Decimal?      @db.Decimal(12, 2)
  startAt      DateTime
  endAt        DateTime
  status       AuctionStatus @default(SCHEDULED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bids         Bid[]
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder    User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  listingId String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     User     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User     @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ConsignmentRequest {
  id               String                 @id @default(cuid())
  referenceNo      String                 @unique
  userId           String
  status           ConsignmentStatus      @default(PENDING)
  vehicleInfo      Json
  condition        Json
  expectations     Json
  approvals        Json
  reviewNote       String                 @default("")
  submittedAt      DateTime               @default(now())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos           ConsignmentPhoto[]
  timeline         ConsignmentTimeline[]
  assignedDealer   DealerAssignment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ConsignmentPhoto {
  id            String               @id @default(cuid())
  requestId     String
  category      VehiclePhotoCategory
  label         String
  fileName      String
  mimeType      String
  fileSize      Int
  imageUrl      String
  isCover       Boolean              @default(false)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  consignment   ConsignmentRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, sortOrder])
}

model DealerAssignment {
  id            String                 @id @default(cuid())
  requestId     String                 @unique
  dealerId      String?
  dealerName    String
  city          String
  district      String?
  contactName   String
  contactPhone  String
  statusNote    String                 @default("")
  status        DealerAssignmentStatus @default(PENDING)
  assignedAt    DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  consignment   ConsignmentRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  dealer        User?                  @relation("AssignedDealer", fields: [dealerId], references: [id], onDelete: SetNull)

  @@index([dealerId, assignedAt])
}

model ConsignmentTimeline {
  id            String               @id @default(cuid())
  requestId     String
  title         String
  description   String
  done          Boolean              @default(true)
  createdAt     DateTime             @default(now())
  consignment   ConsignmentRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}
